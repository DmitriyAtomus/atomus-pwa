{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.atomuscrm.ru/api/:path*"
    },
    {
      "source": "/static/:path*",
      "destination": "https://api.atomuscrm.ru/static/:path*"
    },
    {
      "source": "/kp/:path*",
      "destination": "https://api.atomuscrm.ru/kp/:path*"
    },
    {
      "source": "/a/:token",
      "destination": "/"
    },
    {
      "source": "/c/:token",
      "destination": "/"
    },
    {
      "source": "/b/:token",
      "destination": "/"
    },
    {
      "source": "/d/:token",
      "destination": "/"
    },
    {
      "source": "/u/:token",
      "destination": "/"
    },
    {
      "source": "/dev/:token",
      "destination": "/"
    },
    {
      "source": "/feedback",
      "destination": "/"
    },
    {
      "source": "/feedback/",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ]
}
